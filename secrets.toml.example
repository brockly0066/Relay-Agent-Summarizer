# Copy this file to secrets.toml (same folder) and fill in your real values.
# secrets.toml is gitignored — never commit it.

GEMINI_API_KEY = "your-gemini-key-here"

# Only needed if you want the "Connect Gmail" option (optional).
# Create these in Google Cloud Console — see README for step-by-step setup.
GOOGLE_CLIENT_ID = "your-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET = "your-client-secret"
GOOGLE_REDIRECT_URI = "https://your-app-name.streamlit.app"
